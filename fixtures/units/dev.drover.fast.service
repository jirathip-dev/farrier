[Unit]
Description=dev.drover.fast

[Service]
Type=oneshot
ExecStart=/home/me/.cargo/bin/drover drive --fast
Environment="PATH=/home/me/.cargo/bin:/home/me/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
StandardOutput=append:/home/me/.local/state/drover/tick.log
StandardError=append:/home/me/.local/state/drover/tick.log
